# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

{{ if eq .machine_name "nordhealth" -}}
# ─── Secure Enclave keys via Secretive (this machine only) ───
# Private keys live in the Secure Enclave; ~/.ssh/*.pub are public halves only.
# IdentityFile + IdentitiesOnly pin one identity per host so work and personal
# never offer each other's key.

# Work identity
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    IdentityFile ~/.ssh/nordhealth.pub
    IdentitiesOnly yes

# Personal identity
Host github.com
    HostName github.com
    User git
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    IdentityFile ~/.ssh/personal.pub
    IdentitiesOnly yes

Host forgejo.patilla.es
    Port 2223
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    IdentityFile ~/.ssh/personal.pub
    IdentitiesOnly yes

Host totoro
    HostName totoro
    User dvitto
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    IdentityFile ~/.ssh/personal.pub
    IdentitiesOnly yes
    SetEnv TERM=xterm-256color

Host ushuaia
    HostName ushuaia
    User korta
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    IdentityFile ~/.ssh/personal.pub
    IdentitiesOnly yes
    SetEnv TERM=xterm-256color

Host bars
    HostName bars
    User dvitto
    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    IdentityFile ~/.ssh/personal.pub
    IdentitiesOnly yes
    SetEnv TERM=xterm-256color

# One Touch ID per host per 10 min instead of one per command
Host gitlab.com github.com forgejo.patilla.es totoro ushuaia bars
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%n-%p
    ControlPersist 30m
{{ else -}}
Host totoro
  HostName totoro
  User dvitto
  IdentityFile ~/.ssh/id_ed25519_totoro
  SetEnv TERM=xterm-256color

Host ushuaia
  HostName ushuaia
  User korta
  SetEnv TERM=xterm-256color

Host bars
  HostName bars
  User dvitto
  SetEnv TERM=xterm-256color

# Forgejo totoro
Host forgejo.patilla.es
    IdentityFile ~/.ssh/forgejo
    IdentitiesOnly yes
    Port 2223

# Personal GitHub
Host github.com
    HostName github.com
    User patillacode
    IdentityFile ~/.ssh/github

# GitLab
Host gitlab.com
    HostName gitlab.com
    IdentityFile ~/.ssh/gitlab
    IdentitiesOnly yes
{{ end -}}

Host nordhealth
  HostName nordhealth
  User gonz
  SetEnv TERM=xterm-256color

Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}
#  IdentityFile ~/.ssh/id_rsa
#  IdentityFile ~/.ssh/id_ed25519
