# herdr — terminal workspace manager for AI coding agents
alias h='herdr'
alias ht='herdr --remote totoro'
alias hs='herdr_machine_picker'
alias hch='herdr_cheatsheet'

herdr_cheatsheet() {
  glow ~/.config/herdr/cheatsheet.md
}

herdr_machine_picker() {
  local machine
  machine=$(printf "bars\ntotoro\nnordhealth\n" \
    | fzf --prompt="herdr > " --height=40%)
  [[ -z "$machine" ]] && return
  # ~/.ssh/config supplies the user for each host, so bare names are enough.
  # machine_name (chezmoi data, not `hostname`) is the canonical id — nordhealth's
  # real hostname differs from the "nordhealth" alias used here and in ssh config.
  if [[ "$machine" == "{{ .machine_name }}" ]]; then
    herdr
  else
    herdr --remote "$machine"
  fi
}
