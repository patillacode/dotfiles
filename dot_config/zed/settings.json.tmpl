// Zed settings — managed via chezmoi (see dotfiles/dot_config/zed/settings.json.tmpl)
{
    // --- AI / Agent ---
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "gemini-2.5-pro"
        },
        "model_parameters": []
    },
    "agent_servers": {
        "claude": {
            "default_mode": "plan"
        }
    },
    "features": {
        "edit_prediction_provider": "copilot"
    },
    "edit_predictions": {
        "mode": "eager",
        "enabled_in_text_threads": true,
        "disabled_globs": []
    },

    // --- SSH connections (per-machine) ---
    "ssh_connections": [
        {{- if eq .machine_name "bars" }}
        {
            "host": "totoro",
            "username": "dvitto",
            "args": [],
            "projects": []
        }
        {{- end }}
    ],

    // --- Appearance ---
    "theme": "Tokyo Patilla",
    "icon_theme": "Material Icon Theme",
    "base_keymap": "VSCode",
    "buffer_font_family": "{{ .font.family }}",
    "buffer_font_size": {{ .font.size }},
    "buffer_font_weight": 400,
    "buffer_font_features": {
        "calt": true
    },
    "buffer_line_height": "comfortable",
    "ui_font_family": "{{ .font.family }}",
    "ui_font_size": {{ .font.size }},
    "ui_font_weight": 300,
    "cursor_shape": "bar",
    "cursor_blink": true,
    "active_pane_modifiers": {
        "border_size": 2.0,
        "inactive_opacity": 1.0
    },
    "diff_view_style": "unified",
    "show_whitespaces": "selection",
    "confirm_quit": true,

    // --- Editing ---
    "autosave": "off",
    "format_on_save": "on",
    "formatter": "language_server",
    "tab_size": 4,
    "hard_tabs": false,
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "preferred_line_length": 100,
    "wrap_guides": [100],
    "show_wrap_guides": true,
    "soft_wrap": "none",
    "indent_guides": {
        "enabled": false
    },

    // --- Visual aids ---
    "gutter": {
        "line_numbers": true,
        "runnables": true,
        "breakpoints": true,
        "folds": true,
        "min_line_number_digits": 5
    },
    "minimap": {
        "show": "auto",
        "display_in": "active_editor",
        "thumb": "always",
        "max_width_columns": 80,
        "current_line_highlight": "line"
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "show_background": true
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
            "update_debounce_ms": 150,
            "padding": 4,
            "min_column": 0,
            "max_severity": null
        }
    },
    "preview_tabs": {
        "enabled": false
    },
    "vim_mode": false,

    // --- Git ---
    "git": {
        "git_gutter": "tracked_files",
        "hunk_style": "staged_hollow",
        "inline_blame": {
            "enabled": true,
            "delay_ms": 0,
            "show_commit_summary": false,
            "min_column": 0
        }
    },

    // --- Panels ---
    "project_panel": {
        "button": true,
        "default_width": 250,
        "dock": "left",
        "entry_spacing": "comfortable",
        "file_icons": true,
        "folder_icons": true,
        "git_status": true,
        "hide_root": false,
        "indent_size": 10,
        "auto_reveal_entries": true,
        "auto_fold_dirs": false,
        "scrollbar": {
            "show": "never"
        },
        "show_diagnostics": "all",
        "indent_guides": {
            "show": "never"
        }
    },
    "file_finder": {
        "file_icons": true,
        "modal_max_width": "small",
        "git_status": true
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "close_position": "left",
        "show_close_button": "hover",
        "activate_on_close": "history",
        "show_diagnostics": "all"
    },

    // --- Files ---
    "file_scan_inclusions": [
        ".env*"
    ],
    "private_files": [
        "**/.env*",
        "**/*.pem",
        "**/*.key",
        "**/*.cert",
        "**/*.crt",
        "**/secrets.yml"
    ],
    "redact_private_values": false,
    "file_types": {
        "YAML": ["yml"],
        "Makefile": ["Makefile", "makefile"],
        "Dockerfile": ["Dockerfile*"]
    },

    // --- Terminal ---
    "terminal": {
        "shell": "system",
        "dock": "right",
        "default_width": 640,
        "default_height": 420,
        "working_directory": "always_home",
        "blinking": "on",
        "cursor_shape": "bar",
        "alternate_scroll": "off",
        "option_as_meta": false,
        "copy_on_select": true,
        "button": true,
        "line_height": "comfortable",
        "detect_venv": {
            "on": {
                "directories": [".env", "env", ".venv", "venv"],
                "activate_script": "default"
            }
        },
        "toolbar": {
            "breadcrumbs": false
        },
        "scrollbar": {
            "show": "auto"
        },
        "font_family": "{{ .font.family }}",
        "font_size": {{ .font.size }},
        "font_fallbacks": ["ZedMono Nerd Font Propo"],
        "max_scroll_history_lines": 20000
    },

    // --- Languages ---
    "languages": {
        "Python": {
            "language_servers": [
                "ty",
                "!basedpyright",
                "!pyright",
                "!pylsp",
                "!pyrefly",
                "ruff"
            ],
            "format_on_save": "on",
            "formatter": [
                { "code_action": "source.organizeImports.ruff" },
                { "language_server": { "name": "ruff" } }
            ],
            "debuggers": ["Debugpy"],
            "inlay_hints": {
                "enabled": true,
                "show_type_hints": true,
                "show_parameter_hints": true
            }
        },
        "Makefile": {
            "hard_tabs": true,
            "tab_size": 4
        },
        "Markdown": {
            "format_on_save": "off",
            "use_on_type_format": false,
            "allow_rewrap": "anywhere",
            "soft_wrap": "editor_width",
            "prettier": { "allowed": true }
        },
        "Git Commit": {
            "allow_rewrap": "anywhere"
        },
        "Plain Text": {
            "allow_rewrap": "anywhere"
        },
        "Diff": {
            "show_edit_predictions": false,
            "remove_trailing_whitespace_on_save": false,
            "ensure_final_newline_on_save": false
        },
        "JavaScript": {
            "language_servers": ["!typescript-language-server", "vtsls", "..."],
            "prettier": { "allowed": true }
        },
        "TypeScript": {
            "language_servers": ["!typescript-language-server", "vtsls", "..."],
            "prettier": { "allowed": true }
        },
        "TSX": {
            "language_servers": ["!typescript-language-server", "vtsls", "..."],
            "prettier": { "allowed": true }
        },
        "Vue.js": {
            "language_servers": ["vue-language-server", "..."],
            "prettier": { "allowed": true }
        },
        "CSS": {
            "formatter": "prettier",
            "format_on_save": "on",
            "prettier": { "allowed": true }
        },
        "SCSS": {
            "prettier": { "allowed": true }
        },
        "HTML": {
            "prettier": { "allowed": true }
        },
        "JSON": {
            "prettier": { "allowed": true }
        },
        "JSONC": {
            "prettier": { "allowed": true }
        },
        "GraphQL": {
            "prettier": { "allowed": true }
        },
        "SQL": {
            "prettier": {
                "allowed": true,
                "plugins": ["prettier-plugin-sql"]
            }
        },
        "XML": {
            "prettier": {
                "allowed": true,
                "plugins": ["@prettier/plugin-xml"]
            }
        },
        "YAML": {
            "prettier": {
                "bracketSpacing": false,
                "allowed": false
            },
            "tab_size": 2
        },
        "TOML": {
            "language_servers": ["!Taplo"]
        }
    },

    "lsp": {
        "ty": {
            "initialization_options": {
                "logFile": null,
                "logLevel": "info"
            },
            "settings": {
                "disableLanguageServices": false,
                "diagnosticMode": "openFilesOnly",
                "inlayHints": {
                    "variableTypes": true,
                    "callArgumentNames": true
                },
                "experimental": {
                    "rename": false,
                    "autoImport": false
                }
            }
        }
    },

    // --- Misc ---
    "auto_update": true,
    "restore_on_startup": "last_session",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "auto_install_extensions": {
        "colored-zed-icons-theme": true,
        "csv": true,
        "docker-compose": true,
        "dockerfile": true,
        "html": true,
        "make": true,
        "material-icon-theme": true,
        "python-refactoring": true,
        "python-requirements": true,
        "ruff": true,
        "toml": true,
        "ty": true,
        "xml": true
    }
}
